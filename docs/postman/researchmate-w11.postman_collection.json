{
  "info": {
    "name": "ResearchMate w11 - Secure LLM Chat API",
    "description": "Demo lokal: penolakan tanpa token, login Sanctum, chat JSON/SSE, dan pencabutan token. Jangan ekspor token nyata. Konfigurasikan Ollama atau fallback Senopati pada server terlebih dahulu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8011",
      "type": "string"
    },
    {
      "key": "email",
      "value": "dosenpbkk@its.ac.id",
      "type": "string"
    },
    {
      "key": "password",
      "value": "demo12345",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Tanpa token harus 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/chat-ai",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Bagaimana menyusun pertanyaan riset?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ditolak tanpa token\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login dan simpan token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Akun seeder hanya untuk lokal. Token berlaku satu jam dan memiliki ability chat.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login berhasil\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Chat JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/chat-ai",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Bagaimana menyusun pertanyaan riset tentang pembelajaran adaptif?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Riwayat berhasil dibuat\", () => pm.response.to.have.status(201));",
              "pm.test(\"API Resource sukses\", () => { const body = pm.response.json(); pm.expect(body.status).to.eql(\"success\"); pm.expect(body.data.session_id).to.be.a(\"number\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Streaming SSE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/chat-ai/stream",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat-ai",
            "stream"
          ]
        },
        "description": "Baca event delta, lalu done saat jawaban tersimpan; event error berarti jawaban belum selesai. Body tidak berupa satu dokumen JSON.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Berikan tiga langkah awal telaah literatur.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SSE diterima\", () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Validasi prompt harus 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/chat-ai",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": 123\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Prompt bukan string ditolak\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Cabut token",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "token"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token dicabut\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Token dicabut harus 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/chat-ai",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Apakah token masih aktif?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token lama ditolak\", () => pm.response.to.have.status(401));",
              "pm.collectionVariables.unset(\"token\");"
            ]
          }
        }
      ]
    }
  ]
}
